# Copie ce fichier en .env sur le serveur (jamais dans le chat ni dans GitHub).

# Dossier où sont gardées la base de données et les photos des factures (disque persistant).
DOSSIER_DONNEES=./donnees
PORT=3000
NODE_ENV=production

# Lecture automatique des factures (facultatif). Sans clé : saisie manuelle par l'employé.
ANTHROPIC_API_KEY=

# QuickBooks Online (facultatif). Sans QBO_CLIENT_ID : mode démo, rien n'est envoyé.
# Clés de l'app créée sur developer.intuit.com.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Doit être identique à l'adresse de retour déclarée chez Intuit.
QBO_URL_RETOUR=https://ton-domaine.ca/api/qbo/retour
# sandbox (compagnie de test) ou production (ton vrai QuickBooks).
QBO_ENVIRONNEMENT=sandbox
# Longue phrase aléatoire qui chiffre les jetons QuickBooks en base (ex. : openssl rand -hex 32).
CLE_SECRETE=
